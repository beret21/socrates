#!/bin/bash
# Socrates — "Know Your Self": a session & settings manager for Claude Code
# Usage: socrates [list|name|map|report|doctor|version|help]  (short alias: soc)
set -euo pipefail

# Follow symlinks to find the real install root (~/.local/bin/socrates → install root/bin/socrates)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SOC_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export SOC_ROOT

SOC_DATA_DIR="$HOME/.claude/socrates"
SOC_UPDATE_CACHE="$SOC_DATA_DIR/update-check"
SOC_REMOTE_MANIFEST="https://raw.githubusercontent.com/beret21/socrates/main/.claude-plugin/plugin.json"
SOC_UPDATE_TTL=86400  # check the remote at most once a day

soc_local_version() {
  jq -r '.version // "unknown"' "$SOC_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown"
}

# Fetch the latest published version (2s timeout; empty on failure)
soc_remote_version() {
  curl -fsSL --max-time 2 "$SOC_REMOTE_MANIFEST" 2>/dev/null | jq -r '.version // empty' 2>/dev/null
}

# Cached remote version; refreshes at most once per SOC_UPDATE_TTL
soc_cached_remote_version() {
  local now checked remote
  now=$(date +%s)
  if [ -f "$SOC_UPDATE_CACHE" ]; then
    read -r checked remote < "$SOC_UPDATE_CACHE" || true
    if [ -n "${checked:-}" ] && [ $(( now - checked )) -lt "$SOC_UPDATE_TTL" ]; then
      echo "${remote:-}"
      return 0
    fi
  fi
  remote=$(soc_remote_version) || true   # offline must not abort under set -e
  mkdir -p "$SOC_DATA_DIR"
  echo "$now ${remote:-}" > "$SOC_UPDATE_CACHE"
  echo "${remote:-}"
}

# True if $2 is strictly newer than $1
soc_is_newer() {
  [ -n "$2" ] && [ "$1" != "$2" ] && \
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

# Appended after normal commands (default: manual updates, notice only)
soc_update_notice() {
  local cur remote
  cur=$(soc_local_version)
  remote=$(soc_cached_remote_version)
  if soc_is_newer "$cur" "$remote"; then
    echo "" >&2
    echo "↑ Update available: $cur → $remote — run /plugin update socrates@beret21 (plugin) or git pull (manual)" >&2
  fi
}

usage() {
  cat <<'EOF'
Socrates — a session & settings manager for Claude Code (γνῶθι σεαυτόν)

Usage: socrates <command> [args]   (short alias: soc)

  socrates / socrates list   Session list (fzf). Enter → copy '--resume <UUID>',
                             Ctrl-Y → UUID only, Ctrl-O → full cd+resume command,
                             Ctrl-N → name the highlighted session
  socrates find <text>       Full-text search across ALL session transcripts
                             (something Claude's native picker cannot do)
  socrates name [alias]      Pick a session and set/update its alias
  socrates unname            Pick an alias and remove it (session is untouched)
  socrates map               Print Claude settings & harness status to the terminal
  socrates report            Generate an HTML dashboard and open it in the browser
  socrates update            Update everything: plugin (skill + CLI) and relink,
                             no Claude session needed (manual install: git pull)
  socrates doctor [--fix]    Check the environment (deps, PATH, install, registry,
                             version); --fix repairs missing/broken CLI links
  socrates version           Print the version and check for updates
  socrates help              Show this help

Inside a Claude session, use /socrates <alias> to name the current session.
EOF
}

CMD="${1:-list}"
[ $# -gt 0 ] && shift

case "$CMD" in
  list|ls)
    # shellcheck source=../lib/soc-sessions.sh
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_list "$@"
    soc_update_notice
    ;;
  find|search)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_find "$@"
    soc_update_notice
    ;;
  name)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_name "$@"
    soc_update_notice
    ;;
  unname)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_unname "$@"
    ;;
  update)
    if ! command -v claude >/dev/null 2>&1; then
      echo "claude CLI not found — cannot update the plugin." >&2
      exit 1
    fi
    case "$SOC_ROOT" in
      *"/plugins/cache/"*)
        echo "Updating marketplace and plugin (socrates@beret21)…"
        claude plugin marketplace update beret21
        claude plugin update socrates@beret21
        newest=$(ls -d "$HOME/.claude/plugins/cache/beret21/socrates/"*/ 2>/dev/null | sort -V | tail -1)
        newest="${newest%/}"
        if [ -n "$newest" ]; then
          chmod +x "$newest/bin/socrates" "$newest/skills/name/socreg.sh" 2>/dev/null || true
          mkdir -p "$HOME/.local/bin"
          ln -sfn "$newest/bin/socrates" "$HOME/.local/bin/socrates"
          ln -sfn "$newest/bin/socrates" "$HOME/.local/bin/soc"
          echo "CLI relinked to: $newest"
          "$newest/bin/socrates" version
          echo "Note: skills inside an already-open Claude session refresh after /reload-plugins or a new session."
        else
          echo "Could not locate the plugin cache after the update." >&2
          exit 1
        fi
        ;;
      *)
        echo "Manual install detected — pulling the latest from git…"
        git -C "$SOC_ROOT" pull --ff-only
        "$SOC_ROOT/bin/socrates" version
        ;;
    esac
    ;;
  map|status)
    python3 "$SOC_ROOT/lib/soc_report.py" --terminal "$@"
    soc_update_notice
    ;;
  report)
    python3 "$SOC_ROOT/lib/soc_report.py" --html "$@"
    soc_update_notice
    ;;
  doctor)
    # shellcheck source=../lib/soc-doctor.sh
    source "$SOC_ROOT/lib/soc-doctor.sh"
    soc_doctor "$@"
    ;;
  __preview)
    # Internal: called by the fzf preview pane (not for direct use)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_preview "$@"
    ;;
  version|--version|-v)
    cur=$(soc_local_version)
    echo "socrates $cur"
    remote=$(soc_remote_version) || true   # live check; offline must not abort
    if [ -z "$remote" ]; then
      echo "latest:   (offline — could not reach GitHub)"
    elif soc_is_newer "$cur" "$remote"; then
      echo "latest:   $remote  ↑ update available"
      echo "          plugin: /plugin update socrates@beret21 · manual: git pull"
    else
      echo "latest:   $remote  ✓ up to date"
    fi
    # refresh the notice cache while we are at it
    mkdir -p "$SOC_DATA_DIR"; echo "$(date +%s) ${remote:-}" > "$SOC_UPDATE_CACHE"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    usage
    exit 1
    ;;
esac
