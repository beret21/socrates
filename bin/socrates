#!/bin/bash
# Socrates — "Know Your Self": a session & settings manager for Claude Code
# Usage: socrates [list|name|map|report|version|help]  (short alias: soc)
set -euo pipefail

# Follow symlinks to find the real install root (~/.local/bin/socrates → repo/bin/socrates)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SOC_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export SOC_ROOT

usage() {
  cat <<'EOF'
Socrates — a session & settings manager for Claude Code (γνῶθι σεαυτόν)

Usage: socrates <command> [args]   (short alias: soc)

  socrates / socrates list   Session list (fzf). Enter → copy '--resume <UUID>'
                             to the clipboard, Ctrl-Y → copy the UUID only
  socrates name [alias]      Pick a session and set/update its alias
  socrates map               Print Claude settings & harness status to the terminal
  socrates report            Generate an HTML dashboard and open it in the browser
  socrates version           Print the version
  socrates help              Show this help

Inside a Claude session, use /socrates <alias> to name the current session.
EOF
}

CMD="${1:-list}"
[ $# -gt 0 ] && shift

case "$CMD" in
  list|ls)
    # shellcheck source=../lib/soc-sessions.sh
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_list "$@"
    ;;
  name)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_name "$@"
    ;;
  map|status)
    python3 "$SOC_ROOT/lib/soc_report.py" --terminal "$@"
    ;;
  report)
    python3 "$SOC_ROOT/lib/soc_report.py" --html "$@"
    ;;
  __preview)
    # Internal: called by the fzf preview pane (not for direct use)
    source "$SOC_ROOT/lib/soc-sessions.sh"
    soc_preview "$@"
    ;;
  version|--version|-v)
    if command -v jq >/dev/null 2>&1; then
      v=$(jq -r '.version // "unknown"' "$SOC_ROOT/.claude-plugin/plugin.json" 2>/dev/null)
    else
      v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SOC_ROOT/.claude-plugin/plugin.json" 2>/dev/null)
    fi
    echo "socrates ${v:-unknown}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    usage
    exit 1
    ;;
esac
